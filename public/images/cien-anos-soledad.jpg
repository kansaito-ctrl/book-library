<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a8a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg1)"/>
  <text x="150" y="180" font-family="Georgia, serif" font-size="24" font-weight="bold" fill="white" text-anchor="middle" letter-spacing="1">Cien años</text>
  <text x="150" y="215" font-family="Georgia, serif" font-size="24" font-weight="bold" fill="white" text-anchor="middle" letter-spacing="1">de soledad</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="16" fill="#fde047" text-anchor="middle">Gabriel García Márquez</text>
  <ellipse cx="150" cy="340" rx="60" ry="30" fill="none" stroke="#fde047" stroke-width="2" opacity="0.6"/>
  <ellipse cx="150" cy="340" rx="40" ry="20" fill="none" stroke="#fde047" stroke-width="1" opacity="0.4"/>
  <text x="150" y="400" font-family="Georgia, serif" font-size="12" fill="white" text-anchor="middle" opacity="0.7">Realismo mágico • 1967</text>
</svg>