<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#78350f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#92400e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg)"/>
  <text x="150" y="160" font-family="Georgia, serif" font-size="24" font-weight="bold" fill="#fef3c7" text-anchor="middle">Don Quijote</text>
  <text x="150" y="200" font-family="Georgia, serif" font-size="24" font-weight="bold" fill="#fef3c7" text-anchor="middle">de la Mancha</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="14" fill="#fef3c7" text-anchor="middle" opacity="0.9">Miguel de Cervantes</text>
  <text x="150" y="320" font-family="Georgia, serif" font-size="12" fill="#fef3c7" text-anchor="middle" opacity="0.7">Clásico • 1605</text>
  <rect x="75" y="360" width="150" height="2" fill="#fef3c7" opacity="0.3"/>
  <ellipse cx="150" cy="340" rx="50" ry="25" fill="none" stroke="#fef3c7" stroke-width="2" opacity="0.5"/>
  <line x1="100" y1="340" x2="200" y2="340" stroke="#fef3c7" stroke-width="2" opacity="0.5"/>
</svg>