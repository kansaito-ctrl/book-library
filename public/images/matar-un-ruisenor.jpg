<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1c1917;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#44403c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg)"/>
  <text x="150" y="160" font-family="Georgia, serif" font-size="20" font-weight="bold" fill="#d6d3d1" text-anchor="middle">Matar un</text>
  <text x="150" y="200" font-family="Georgia, serif" font-size="20" font-weight="bold" fill="#d6d3d1" text-anchor="middle">ruiseñor</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="14" fill="#d6d3d1" text-anchor="middle" opacity="0.9">Harper Lee</text>
  <text x="150" y="320" font-family="Georgia, serif" font-size="12" fill="#d6d3d1" text-anchor="middle" opacity="0.7">Drama social • 1960</text>
  <rect x="75" y="360" width="150" height="2" fill="#d6d3d1" opacity="0.3"/>
  <!-- Pájaro simple -->
  <g transform="translate(150, 330)" fill="#d6d3d1" opacity="0.6">
    <path d="M0,0 Q-20,-15 -30,-5 Q-15,0 -20,15 Q-5,10 0,0" />
    <path d="M0,0 Q20,-15 30,-5 Q15,0 20,15 Q5,10 0,0" />
    <circle cx="0" cy="0" r="4"/>
  </g>
</svg>