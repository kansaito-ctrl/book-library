<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#111827;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#374151;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg)"/>
  <text x="150" y="180" font-family="Georgia, serif" font-size="48" font-weight="bold" fill="white" text-anchor="middle" letter-spacing="4">1984</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="14" fill="white" text-anchor="middle" opacity="0.9">George Orwell</text>
  <text x="150" y="320" font-family="Georgia, serif" font-size="12" fill="white" text-anchor="middle" opacity="0.7">Distopía • 1949</text>
  <rect x="75" y="360" width="150" height="2" fill="white" opacity="0.3"/>
  <circle cx="150" cy="340" r="40" fill="none" stroke="white" stroke-width="2" opacity="0.4"/>
  <text x="150" y="345" font-family="Georgia, serif" font-size="24" fill="white" text-anchor="middle" opacity="0.6">👁</text>
</svg>