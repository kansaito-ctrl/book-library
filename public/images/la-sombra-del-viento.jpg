  <path d="M150 300 Q120 280 100 310 Q120 340 150 320 Q180 340 200 310 Q180 280 150 300" fill="#f3f4f6" opacity="0.2"/>
  <line x1="130" y1="300" x2="170" y2="300" stroke="#f3f4f6" stroke-width="1" opacity="0.5"/>
</svg>