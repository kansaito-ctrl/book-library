<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4b5563;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg)"/>
  <text x="150" y="160" font-family="Georgia, serif" font-size="22" font-weight="bold" fill="#f3f4f6" text-anchor="middle">La sombra</text>
  <text x="150" y="200" font-family="Georgia, serif" font-size="22" font-weight="bold" fill="#f3f4f6" text-anchor="middle">del viento</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="14" fill="#f3f4f6" text-anchor="middle" opacity="0.9">Carlos Ruiz Zafón</text>
  <text x="150" y="320" font-family="Georgia, serif" font-size="12" fill="#f3f4f6" text-anchor="middle" opacity="0.7">Misterio • 2001</text>
