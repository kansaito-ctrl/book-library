<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 450">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#14532d;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#166534;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="450" fill="url(#bg)"/>
  <text x="150" y="180" font-family="Georgia, serif" font-size="36" font-weight="bold" fill="#86efac" text-anchor="middle">El hobbit</text>
  <text x="150" y="280" font-family="Georgia, serif" font-size="14" fill="#86efac" text-anchor="middle" opacity="0.9">J.R.R. Tolkien</text>
  <text x="150" y="320" font-family="Georgia, serif" font-size="12" fill="#86efac" text-anchor="middle" opacity="0.7">Fantasía • 1937</text>
  <rect x="75" y="360" width="150" height="2" fill="#86efac" opacity="0.3"/>
  <circle cx="150" cy="340" r="40" fill="none" stroke="#86efac" stroke-width="2" opacity="0.5"/>
  <text x="150" y="345" font-family="Georgia, serif" font-size="24" fill="#86efac" text-anchor="middle" opacity="0.7">💍</text>
</svg>