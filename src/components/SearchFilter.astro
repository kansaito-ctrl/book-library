---
// SearchFilter.astro - Búsqueda y filtros para el catálogo
interface Props {
  genres: string[];
  selectedGenre?: string;
  searchQuery?: string;
}

const { genres, selectedGenre = '', searchQuery = '' } = Astro.props;
---

<!--
  Componente de búsqueda y filtros con Alpine.js
  - Búsqueda en tiempo real (debounced)
  - Filtro por género
  - Contador de resultados
  - Skeleton loaders durante filtrado
-->

<section class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 md:p-6 mb-6" x-data="searchFilter" x-init="init()">
  <div class="flex flex-col md:flex-row md:items-center gap-4">
    <!-- Búsqueda -->
    <div class="flex-1 relative">
      <label for="search-input" class="sr-only">Buscar libros</label>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          id="search-input"
          x-model="searchQuery"
          x-on:input.debounce.300ms="filterBooks()"
          placeholder="Buscar por título, autor, ISBN..."
          class="input pl-10"
          autocomplete="off"
          aria-describedby="search-hint"
        />
      </div>
      <p id="search-hint" class="sr-only">Escribe para filtrar libros por título, autor o ISBN</p>
    </div>

    <!-- Filtro género -->
    <div class="w-full md:w-48">
      <label for="genre-select" class="label">Género</label>
      <select
        id="genre-select"
        x-model="selectedGenre"
        x-on:change="filterBooks()"
        class="input appearance-none bg-white dark:bg-gray-800"
        aria-describedby="genre-hint"
      >
        <option value="">Todos los géneros</option>
        <template x-for="genre in genres" :key="genre">
          <option :value="genre" x-text="genre"></option>
        </template>
      </select>
      <p id="genre-hint" class="sr-only">Selecciona un género para filtrar</p>
    </div>

    <!-- Botón limpiar filtros -->
    <div class="flex items-end w-full md:w-auto">
      <button
        x-show="hasActiveFilters"
        @click="clearFilters()"
        class="btn-secondary text-sm whitespace-nowrap"
        aria-label="Limpiar todos los filtros"
      >
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Limpiar
      </button>
    </div>
  </div>

  <!-- Contador de resultados y estado -->
  <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <p class="text-sm text-gray-600 dark:text-gray-400" aria-live="polite" x-text="resultsText"></p>

    <!-- Ordenación -->
    <div class="flex items-center gap-2">
      <label for="sort-select" class="text-sm text-gray-600 dark:text-gray-400">Ordenar:</label>
      <select
        id="sort-select"
        x-model="sortBy"
        @change="filterBooks()"
        class="input w-auto py-2"
      >
        <option value="relevance">Relevancia</option>
        <option value="title-asc">Título (A-Z)</option>
        <option value="title-desc">Título (Z-A)</option>
        <option value="author-asc">Autor (A-Z)</option>
        <option value="year-desc">Más nuevos</option>
        <option value="year-asc">Más antiguos</option>
        <option value="rating-desc">Mejor valorados</option>
      </select>
    </div>
  </div>

  <!-- Mensaje sin resultados -->
  <template x-if="filteredBooks.length === 0 && (searchQuery || selectedGenre)">
    <div class="mt-6 text-center py-8">
      <svg class="mx-auto w-16 h-16 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-gray-100">No se encontraron libros</h3>
      <p class="mt-2 text-gray-500 dark:text-gray-400">Intenta con otros términos de búsqueda o quita los filtros.</p>
      <button @click="clearFilters()" class="mt-4 btn-primary">Limpiar filtros</button>
    </div>
  </template>
</section>

<style>
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>