---
// Footer.astro - Pie de página
---

<footer class="bg-gray-900 text-gray-300" role="contentinfo">
  <div class="container-custom py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12">
      <!-- Marca -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-white mb-4" aria-label="BiblioEscuela - Inicio">
          <svg class="w-8 h-8 text-primary-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
          </svg>
          <span class="font-display font-bold text-xl">BiblioEscuela</span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Prototipo de librería digital para proyecto escolar. Catálogo de libros con búsqueda, filtros y fichas detalladas.
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Enlaces rápidos">
        <h3 class="font-semibold text-white mb-4">Enlaces rápidos</h3>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-primary-400 transition-colors text-sm">Inicio</a></li>
          <li><a href="/catalogo" class="hover:text-primary-400 transition-colors text-sm">Catálogo completo</a></li>
          <li><a href="/about" class="hover:text-primary-400 transition-colors text-sm">Nosotros</a></li>
        </ul>
      </nav>

      <!-- Categorías -->
      <nav aria-label="Géneros">
        <h3 class="font-semibold text-white mb-4">Géneros</h3>
        <ul class="space-y-2">
          <li><a href="/catalogo?genre=Cl%C3%A1sico" class="hover:text-primary-400 transition-colors text-sm">Clásicos</a></li>
          <li><a href="/catalogo?genre=Fantas%C3%ADa" class="hover:text-primary-400 transition-colors text-sm">Fantasía</a></li>
          <li><a href="/catalogo?genre=Misterio" class="hover:text-primary-400 transition-colors text-sm">Misterio</a></li>
          <li><a href="/catalogo?genre=Ciencia%20ficci%C3%B3n" class="hover:text-primary-400 transition-colors text-sm">Ciencia ficción</a></li>
          <li><a href="/catalogo?genre=Hist%C3%B3rico" class="hover:text-primary-400 transition-colors text-sm">Histórico</a></li>
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <h3 class="font-semibold text-white mb-4">Contacto</h3>
        <address class="not-italic text-sm space-y-2">
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Calle Escuela 123, Ciudad</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:hola@biblioescuela.edu" class="hover:text-primary-400 transition-colors">hola@biblioescuela.edu</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>+34 900 123 456</span>
          </p>
        </address>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        &copy; 2025 BiblioEscuela. Proyecto educativo - Prototipo para escuela.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-gray-500 hover:text-primary-400 transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href="#" class="text-gray-500 hover:text-primary-400 transition-colors" aria-label="Twitter">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>
          </svg>
        </a>
        <a href="#" class="text-gray-500 hover:text-primary-400 transition-colors" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-.127-1.28-.073-1.689-.073-4.947 0-3.26-.014-3.667-.072-4.947-.2-4.358-2.618-6.78-6.98-6.98-.127-1.28-.073-1.689-.073-4.947 0-3.26.014-3.667.072-4.947.196-4.354 2.617-6.78 6.98-6.98z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- PWA Install hint for mobile -->
  <div class="hidden md:block mt-8 p-4 bg-primary-50 dark:bg-primary-900/20 rounded-xl text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">
      💡 <strong>Instala la app</strong> en tu móvil para acceso offline y notificaciones.
    </p>
  </div>
</footer>