---
// BookCard.astro - Tarjeta de libro reutilizable
interface Props {
  book: {
    id: number;
    slug: string;
    title: string;
    author: string;
    genre: string;
    year: number;
    cover: string;
    description: string;
    available: boolean;
    featured?: boolean;
    rating: number;
  };
  variant?: 'default' | 'compact' | 'featured';
}

const { book, variant = 'default' } = Astro.props;
const isCompact = variant === 'compact';
const isFeatured = variant === 'featured';
---

<!--
  Tarjeta de libro accesible y responsive
  variant="default": Grid normal (catálogo)
  variant="compact": Lista compacta (resultados búsqueda)
  variant="featured": Destacada grande (home)
-->

<article class="card group h-full flex flex-col" aria-labelledby={`book-title-${book.id}`}>
  <!-- Imagen de portada -->
  <div class="relative aspect-[2/3] overflow-hidden bg-gray-100">
    <img
      src={book.cover}
      alt=""
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      width="300"
      height="450"
    />
    <!-- Badge destacado -->
    {book.featured && (
      <span class="absolute top-3 left-3 badge bg-amber-500 text-white">
        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        Destacado
      </span>
    )}

    <!-- Badge disponibilidad -->
    <div class="absolute top-3 right-3">
      <span class={book.available ? 'badge badge-available' : 'badge badge-unavailable'}>
        {book.available ? 'Disponible' : 'Prestado'}
      </span>
    </div>

    <!-- Overlay en hover para tarjetas featured -->
    {isFeatured && (
      <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
        <a href={`/libro/${book.slug}`} class="btn-primary w-full text-center">
          Ver detalles
        </a>
      </div>
    )}
  </div>

  <!-- Contenido -->
  <div class="p-4 md:p-5 flex flex-col flex-1">
    <!-- Género -->
    <span class="badge badge-genre mb-3 inline-block">{book.genre}</span>

    <!-- Título -->
    <h3
      id={`book-title-${book.id}`}
      class="font-display text-lg md:text-xl font-medium text-gray-900 mb-2 line-clamp-2 group-hover:text-primary-600 transition-colors"
    >
      <a href={`/libro/${book.slug}`} class="hover:underline">
        {book.title}
      </a>
    </h3>

    <!-- Autor -->
    <p class="text-gray-600 text-sm mb-3 flex items-center gap-1">
      <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span class="line-clamp-1">{book.author}</span>
    </p>

    <!-- Metadatos compactos -->
    <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 mb-3">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {book.year}
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        {book.pages} p.
      </span>
      <span class="flex items-center gap-1 text-amber-500" aria-label={`Valoración: ${book.rating} de 5 estrellas`}>
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        {book.rating}
      </span>
    </div>

    <!-- Descripción (solo en default/featured) -->
    {!isCompact && (
      <p class="text-gray-600 text-sm leading-relaxed mb-4 flex-1 line-clamp-3">
        {book.description}
      </p>
    )}

    <!-- Acción principal -->
    <div class="mt-auto pt-3 border-t border-gray-100">
      {isFeatured ? (
        <a href={`/libro/${book.slug}`} class="btn-primary w-full text-center">
          Ver ficha completa
        </a>
      ) : (
        <a href={`/libro/${book.slug}`} class="btn-secondary w-full text-center">
          Ver detalles
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>