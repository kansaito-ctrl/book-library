---
// catalogo.astro - Página de catálogo con búsqueda y filtros
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchFilter from '../components/SearchFilter.astro';
import BookCard from '../components/BookCard.astro';
import booksData from '../data/books.json';

const books = booksData as typeof booksData;
const genres = [...new Set(books.map(b => b.genre))].sort();

// Obtener parámetros de URL
const url = new URL(Astro.request.url);
const searchQuery = url.searchParams.get('q') || '';
const selectedGenre = url.searchParams.get('genre') || '';
---

<Layout title="Catálogo completo - BiblioEscuela" description="Explora nuestro catálogo completo de libros. Busca por título, autor o ISBN, y filtra por género.">
  <Header />

  <main class="section">
    <div class="container-custom">
      <!-- Header del catálogo -->
      <header class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 dark:text-gray-100 mb-2">Catálogo completo</h1>
          <p class="text-gray-600 dark:text-gray-400 text-lg">Explora nuestra colección de {books.length} libros. Usa la búsqueda y los filtros para encontrar tu próxima lectura.</p>
        </div>
        <div class="flex flex-wrap gap-2" id="export-buttons">
          <button type="button" id="export-csv" class="btn-secondary text-sm" aria-label="Exportar catálogo a CSV">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            CSV
          </button>
          <button type="button" id="export-pdf" class="btn-secondary text-sm" aria-label="Exportar catálogo a PDF">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            PDF
          </button>
        </div>
      </header>

      <!-- Búsqueda y filtros -->
      <SearchFilter
        genres={genres}
        selectedGenre={selectedGenre}
        searchQuery={searchQuery}
      />

      <!-- Grid de libros -->
      <section aria-labelledby="books-heading">
        <h2 id="books-heading" class="sr-only">Lista de libros</h2>
        <div
          id="books-grid"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
          data-books={JSON.stringify(books)}
          role="list"
        >
          {books.map(book => (
            <BookCard book={book} variant="default" />
          ))}
        </div>

        <!-- Skeleton loaders (shown during filtering) -->
        <div id="skeleton-grid" style="display: none;" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" aria-live="polite" aria-busy="true">
          {[...Array(12)].map((_, i) => (
            <article key={i} class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded-xl p-4 space-y-3">
              <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded aspect-[2/3] w-full"></div>
              <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded h-6 w-3/4 mb-3"></div>
              <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded h-4 w-full mb-2"></div>
              <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded h-4 w-1/2 mb-2"></div>
              <div class="animate-pulse bg-gray-200 dark:bg-gray-700 rounded h-10 w-full mt-4 rounded-lg"></div>
            </article>
          ))}
        </div>
      </section>

      <!-- Mensaje cuando no hay resultados (fallback sin JS) -->
      <noscript>
        <div class="text-center py-12" id="no-js-message">
          <p class="text-gray-600 dark:text-gray-400">Activa JavaScript para usar la búsqueda y filtros en tiempo real.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mt-8">
            {books.map(book => (
              <BookCard book={book} variant="default" />
            ))}
          </div>
        </div>
      </noscript>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Export functionality
  document.addEventListener('DOMContentLoaded', () => {
    const booksData = JSON.parse(document.getElementById('books-grid').dataset.books || '[]');

    // Get filtered books from Alpine component
    function getFilteredBooks() {
      const searchFilterEl = document.querySelector('[x-data="searchFilter"]');
      if (searchFilterEl && searchFilterEl.__x) {
        return searchFilterEl.__x.getUnobservedData().filteredBooks;
      }
      return booksData;
    }

    // Export to CSV
    document.getElementById('export-csv')?.addEventListener('click', () => {
      const books = getFilteredBooks();
      const headers = ['Título', 'Autor', 'Género', 'Año', 'Páginas', 'ISBN', 'Disponible', 'Rating'];
      const rows = books.map(book => [
        `"${book.title}"`,
        `"${book.author}"`,
        `"${book.genre}"`,
        book.year,
        book.pages,
        `"${book.isbn}"`,
        book.available ? 'Sí' : 'No',
        book.rating
      ]);
      const csv = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `catalogo-biblioescuela-${new Date().toISOString().split('T')[0]}.csv`;
      link.click();

      showToast('Catálogo exportado a CSV', 'success');
    });

    // Export to PDF
    document.getElementById('export-pdf')?.addEventListener('click', async () => {
      const books = getFilteredBooks();
      const { jsPDF } = window.jspdf || await import('https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js');
      const doc = new jsPDF();

      doc.setFontSize(20);
      doc.text('Catálogo BiblioEscuela', 14, 22);
      doc.setFontSize(10);
      doc.text(`Exportado: ${new Date().toLocaleDateString('es-ES')} | ${getFilteredBooks().length} libros`, 14, 28);

      let y = 36;
      getFilteredBooks().forEach((book, i) => {
        if (y > 270) { doc.addPage(); y = 14; }
        doc.setFontSize(11);
        doc.setFont(undefined, 'bold');
        doc.text(`${i + 1}. ${book.title}`, 14, y);
        doc.setFont(undefined, 'normal');
        doc.setFontSize(9);
        y += 6;
        doc.text(`Autor: ${book.author} | Género: ${book.genre} | Año: ${book.year}`, 14, y);
        y += 5;
        doc.text(`Páginas: ${book.pages} | ISBN: ${book.isbn} | ${book.available ? 'Disponible' : 'Prestado'} | ★ ${book.rating}`, 14, y);
        y += 10;
      });

      doc.save(`catalogo-biblioescuela-${new Date().toISOString().split('T')[0]}.pdf`);
      showToast('Catálogo exportado a PDF', 'success');
    });

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `toast toast-${type} pointer-events-auto`;
      toast.setAttribute('role', 'alert');
      toast.setAttribute('aria-live', 'polite');
      toast.innerHTML = `<span>${message}</span><button type="button" class="ml-4 text-white/80 hover:text-white transition-opacity" aria-label="Cerrar"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg></button>`;
      toast.querySelector('button').addEventListener('click', () => { toast.classList.add('animate-slide-out'); setTimeout(() => toast.remove(), 200); });
      container.appendChild(toast);
      setTimeout(() => { if (toast.parentElement) { toast.classList.add('animate-slide-out'); setTimeout(() => toast.remove(), 200); } }, 4000);
    }
  });
</script>