---
// comparar.astro - Comparar libros lado a lado
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import booksData from '../data/books.json';

const books = booksData as typeof booksData;
const allBooks = books;

// Obtener parámetros de URL para preseleccionar libros
const url = new URL(Astro.request.url);
const book1Slug = url.searchParams.get('book1') || '';
const book2Slug = url.searchParams.get('book2') || '';
const book3Slug = url.searchParams.get('book3') || '';

const book1 = book1Slug ? books.find(b => b.slug === book1Slug) : null;
const book2 = book2Slug ? books.find(b => b.slug === book2Slug) : null;
const book3 = book3Slug ? books.find(b => b.slug === book3Slug) : null;

const selectedBooks = [book1, book2, book3].filter(Boolean) as typeof books;
---

<Layout title="Comparar libros - BiblioEscuela" description="Compara libros lado a lado para elegir tu próxima lectura.">
  <Header />

  <main class="section">
    <div class="container-custom">
      <!-- Header -->
      <header class="mb-8 text-center">
        <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 dark:text-gray-100 mb-2">Comparar libros</h1>
        <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl mx-auto">
          Selecciona hasta 3 libros para comparar sus características lado a lado.
        </p>
      </header>

      <!-- Selector de libros -->
      <section class="mb-8" aria-labelledby="selector-heading">
        <h2 id="selector-heading" class="sr-only">Seleccionar libros</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="book-selectors">
          {Array.from({ length: 3 }, (_, i) => (
            <div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-sm border border-gray-100 dark:border-gray-700">
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                Libro {i + 1}
              </label>
              <select
                class="input"
                id={`book-select-${i + 1}`}
                data-index={i}
                aria-label={`Seleccionar libro ${i + 1}`}
              >
                <option value="">-- Seleccionar libro --</option>
                {allBooks.map(book => (
                  <option value={book.slug} selected={book.slug === [book1Slug, book2Slug, book3Slug][i]}>
                    {book.title} — {book.author}
                  </option>
                ))}
              </select>
            </div>
          ))}
        </div>
        <div class="mt-4 text-center">
          <a
            href="/comparar"
            class="btn-secondary text-sm"
            id="clear-comparison"
          >
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Limpiar comparación
          </a>
        </div>
      </section>

      <!-- Comparación -->
      {selectedBooks.length > 0 && (
        <section aria-labelledby="comparison-heading">
          <h2 id="comparison-heading" class="sr-only">Tabla de comparación</h2>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[800px]" role="table">
              <thead>
                <tr class="bg-gray-50 dark:bg-gray-800">
                  <th class="p-4 text-left font-semibold text-gray-900 dark:text-gray-100 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Característica
                  </th>
                  {selectedBooks.map((book, i) => (
                    <th key={book.id} class="p-4 text-center font-semibold text-gray-900 dark:text-gray-100 bg-gray-50 dark:bg-gray-800">
                      <div class="flex flex-col items-center gap-2">
                        <img
                          src={book.cover}
                          alt={`Portada de ${book.title}`}
                          class="w-24 h-36 object-cover rounded-lg shadow-md mx-auto"
                          loading="lazy"
                        />
                        <div class="text-sm">
                          <span class="font-medium">{book.title}</span>
                          <br />
                          <span class="text-gray-500 dark:text-gray-400">{book.author}</span>
                        </div>
                        <a href={`/libro/${book.slug}`} class="btn-secondary text-xs mt-1">Ver ficha</a>
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Género
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center">
                      <span class="badge badge-genre">{book.genre}</span>
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Año de publicación
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center text-gray-900 dark:text-gray-100 font-mono text-lg">
                      {book.year}
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Páginas
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center text-gray-900 dark:text-gray-100 font-mono text-lg">
                      {book.pages.toLocaleString()}
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    ISBN
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center text-gray-600 dark:text-gray-400 font-mono text-sm">
                      {book.isbn}
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Disponibilidad
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center">
                      <span class={book.available ? 'badge badge-available' : 'badge badge-unavailable'}>
                        {book.available ? 'Disponible' : 'Prestado'}
                      </span>
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Valoración
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center">
                      <div class="flex items-center justify-center gap-1">
                        {[...Array(5)].map((_, star) => (
                          <svg
                            key={star}
                            class={`w-5 h-5 ${star < Math.round(book.rating) ? 'fill-amber-400 text-amber-400' : 'text-gray-300 dark:text-gray-600'}`}
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        ))}
                      </div>
                      <span class="text-sm text-gray-600 dark:text-gray-400 ml-1">{book.rating}/5</span>
                    </td>
                  ))}
                </tr>
                <tr>
                  <th class="p-4 font-medium text-gray-700 dark:text-gray-300 sticky left-0 bg-white dark:bg-gray-900 z-10">
                    Destacado
                  </th>
                  {selectedBooks.map(book => (
                    <td key={book.id} class="p-4 text-center">
                      {book.featured && (
                        <span class="badge bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400">
                          Sí
                        </span>
                      )}
                      {!book.featured && (
                        <span class="text-gray-400 dark:text-gray-500">No</span>
                      )}
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      )}

      {selectedBooks.length === 0 && (
        <section class="text-center py-16" aria-labelledby="empty-heading">
          <h2 id="empty-heading" class="text-2xl font-display font-bold text-gray-900 dark:text-gray-100 mb-4">
            Selecciona libros para comparar
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
            Usa los selectores de arriba para elegir hasta 3 libros y ver su comparación detallada.
          </p>
          <a href="/catalogo" class="btn-primary inline-flex items-center gap-2">
            Ir al catálogo
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </section>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Update URL when selectors change
  document.addEventListener('DOMContentLoaded', () => {
    const selectors = document.querySelectorAll('[id^="book-select-"]');

    selectors.forEach(select => {
      select.addEventListener('change', () => {
        const params = new URLSearchParams(window.location.search);

        // Update all selectors in URL
        document.querySelectorAll('[id^="book-select-"]').forEach((sel, i) => {
          const value = sel.value;
          if (value) {
            params.set(`book${i + 1}`, value);
          } else {
            params.delete(`book${i + 1}`);
          }
        });

        // Update URL without reload
        const newURL = `${window.location.pathname}${params.toString() ? '?' + params.toString() : ''}`;
        window.history.replaceState({}, '', newURL);
      });
    });

    // Clear comparison
    document.getElementById('clear-comparison')?.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = '/comparar';
    });
  });
</script>