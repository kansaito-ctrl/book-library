---
// libro/[slug].astro - Página de detalle de libro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import booksData from '../../data/books.json';

export async function getStaticPaths() {
  const books = booksData as typeof booksData;
  return books.map(book => ({
    params: { slug: book.slug },
    props: { book }
  }));
}

const { book } = Astro.props;
const books = booksData as typeof booksData;
const relatedBooks = books.filter(b => b.genre === book.genre && b.id !== book.id).slice(0, 3);
---

<Layout title={`${book.title} - BiblioEscuela`} description={book.description}>
  <Header />

  <main>
    <!-- Breadcrumb -->
    <nav class="bg-warm-50 py-4" aria-label="Navegación">
      <div class="container-custom">
        <ol class="flex items-center gap-2 text-sm" role="list">
          <li><a href="/" class="text-gray-500 hover:text-primary-600">Inicio</a></li>
          <li class="text-gray-400" aria-hidden="true">/</li>
          <li><a href="/catalogo" class="text-gray-500 hover:text-primary-600">Catálogo</a></li>
          <li class="text-gray-400" aria-hidden="true">/</li>
          <li><span class="text-gray-900 font-medium truncate max-w-xs" aria-current="page">{book.title}</span></li>
        </ol>
      </div>
    </nav>

    <!-- Ficha del libro -->
    <section class="section bg-white" aria-labelledby="book-title">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
          <!-- Portada y info principal -->
          <div class="lg:col-span-1">
            <div class="sticky top-24">
              <div class="relative aspect-[2/3] rounded-xl overflow-hidden shadow-2xl bg-gray-100">
                <img
                  src={book.cover}
                  alt={`Portada de ${book.title}`}
                  class="w-full h-full object-cover"
                  width="400"
                  height="600"
                />
              </div>

              <!-- Badges -->
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="badge badge-genre">{book.genre}</span>
                <span class={book.available ? 'badge badge-available' : 'badge badge-unavailable'}>
                  {book.available ? 'Disponible para préstamo' : 'Actualmente prestado'}
                </span>
                {book.featured && (
                  <span class="badge bg-amber-100 text-amber-800">Destacado</span>
                )}
              </div>

              <!-- Valoración -->
              <div class="mt-4 flex items-center gap-3">
                <div class="flex items-center gap-1" aria-label={`Valoración: ${book.rating} de 5 estrellas`}>
                  {[...Array(5)].map((_, i) => (
                    <svg class="w-5 h-5 {i < Math.round(book.rating) ? 'fill-amber-400 text-amber-400' : 'text-gray-300'}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>
                <span class="text-gray-600 text-sm">{book.rating}/5 ({book.id * 127} reseñas)</span>
              </div>

              <!-- Acciones -->
              <div class="mt-6 flex flex-col gap-3">
                {book.available ? (
                  <button class="btn-primary w-full text-center" disabled>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    Solicitar préstamo
                  </button>
                ) : (
                  <button class="btn-secondary w-full text-center" disabled>
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Reservar (prestado)
                  </button>
                )}
                <button class="btn-secondary w-full text-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                  </svg>
                  Añadir a favoritos
                </button>
                <button class="btn-secondary w-full text-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                  </svg>
                  Compartir
                </button>
              </div>
            </div>
          </div>

          <!-- Información detallada -->
          <div class="lg:col-span-2">
            <header class="mb-6">
              <h1 id="book-title" class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-3">{book.title}</h1>
              <p class="text-xl text-gray-600">por <span class="font-medium text-gray-900">{book.author}</span></p>
            </header>

            <!-- Metadatos -->
            <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 p-4 bg-warm-50 rounded-xl">
              <div>
                <dt class="text-xs text-gray-500 uppercase tracking-wide">Año</dt>
                <dd class="font-medium text-gray-900">{book.year}</dd>
              </div>
              <div>
                <dt class="text-xs text-gray-500 uppercase tracking-wide">Páginas</dt>
                <dd class="font-medium text-gray-900">{book.pages}</dd>
              </div>
              <div>
                <dt class="text-xs text-gray-500 uppercase tracking-wide">ISBN</dt>
                <dd class="font-medium text-gray-900 text-sm font-mono">{book.isbn}</dd>
              </div>
              <div>
                <dt class="text-xs text-gray-500 uppercase tracking-wide">Género</dt>
                <dd class="font-medium text-gray-900">{book.genre}</dd>
              </div>
            </dl>

            <!-- Descripción larga -->
            <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
              <h2 class="font-display text-2xl font-bold text-gray-900 mb-4">Sinopsis</h2>
              <div class="whitespace-pre-wrap">{book.longDescription}</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Libros relacionados -->
    {relatedBooks.length > 0 && (
      <section class="section bg-warm-50" aria-labelledby="related-heading">
        <div class="container-custom">
          <header class="mb-8">
            <h2 id="related-heading" class="text-2xl md:text-3xl font-display font-bold text-gray-900">Más libros de {book.genre}</h2>
            <p class="text-gray-600">Si te gustó este, te pueden interesar estos títulos del mismo género</p>
          </header>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
            {relatedBooks.map(relatedBook => (
              <BookCard book={relatedBook} variant="default" />
            ))}
          </div>

          <div class="text-center mt-8">
            <a href={`/catalogo?genre=${encodeURIComponent(book.genre)}`} class="btn-secondary inline-flex items-center gap-2">
              Ver todos los libros de {book.genre}
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>